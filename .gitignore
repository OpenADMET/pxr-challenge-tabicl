__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
.ruff_cache/
.pytest_cache/

# everything under data/ is reproducible from code, except the committed split
# resources the recipes point at
data/*
!data/splits/

# run directories, the aggregated table, and logs: large, and rebuilt from the
# recipes. The gate decisions are neither. They are small records of what each
# stage settled, they are what every later stage reads to know what to run, and
# a manifest cannot be reviewed without them: seeing that the descriptor gate
# took RDKit at 128 over a native leader, on a cost tie-break inside the
# leader's seed spread, should not require refitting sixty models. Each one
# carries the repo commit and package versions it was decided under
results/*
!results/gates/

# the per-compound predictions of every run, so a figure can be rebuilt on a
# machine that never ran the sweep. run/08_figures.py draws on these and the
# gates and on nothing else under results/, so the rest of a run directory
# stays out
!results/tabular/
!results/gnn/
!results/uncertainty/
results/tabular/*/*/*
!results/tabular/*/seed*/predictions.csv
results/gnn/*/*/*
!results/gnn/*/seed*/predictions.csv
results/uncertainty/*/*
!results/uncertainty/*/points.csv
!results/uncertainty/*/coverage.csv

# each feature block's column count, recorded where the feature caches exist, so
# a figure built on a machine without them still names its blocks' widths
!results/block_dims.json
logs/

# local type-checker override for a checkout whose environment is not ./.venv;
# takes precedence over the [tool.pyright] block in pyproject.toml
pyrightconfig.json
